# Copy to server/.env. Never commit server/.env.
# "mock" runs without PayPal (same flows, in memory). "sandbox" uses the real PayPal sandbox.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
PUBLIC_BASE_URL=http://localhost:4500
# Where the web app runs (PayPal sends the owner back here after approving).
WEB_URL=http://localhost:5190
